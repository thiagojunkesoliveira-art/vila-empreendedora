{
  "name": "vila-empreendedora",
  "productName": "Vila Empreendedora",
  "version": "3.1.0",
  "description": "Último Abrigo: sobrevivência zumbi em mundo aberto, com pixel art. Colete, construa sua base e resista às hordas.",
  "main": "main.js",
  "author": "Vila Empreendedora",
  "license": "UNLICENSED",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "icon": "node scripts/make-icon.mjs",
    "web": "node scripts/build-web.mjs",
    "dist": "electron-builder --win --publish never",
    "release": "electron-builder --win --publish always"
  },
  "build": {
    "appId": "io.github.vilaempreendedora.app",
    "productName": "Vila Empreendedora",
    "copyright": "Uso pessoal",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "Vila-Empreendedora-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Vila Empreendedora",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "thiagojunkesoliveira-art",
        "repo": "vila-empreendedora",
        "releaseType": "release"
      }
    ]
  },
  "devDependencies": {
    "@fontsource/pixelify-sans": "^5.3.0",
    "@fontsource/press-start-2p": "^5.3.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
